# ─── Auction Dashboard Secrets ───────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in real values.
# ⚠️  NEVER commit secrets.toml to version control!
#
# On Streamlit Community Cloud, paste this content into
# App Settings → Secrets (Advanced Settings).
# ─────────────────────────────────────────────────────────────

[database]
# Supabase → Settings → Database → Connection string → URI (use Connection Pooler, port 6543)
url = "postgresql://postgres:[YOUR-PASSWORD]@db.kxnhptckxxervvbuxamp.supabase.co:6543/postgres"


[passcodes]
# Strong passcodes for admin and viewer access
admin = "CHANGE-ME-admin-secret"
viewer = "CHANGE-ME-viewer-secret"
